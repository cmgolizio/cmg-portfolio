# Contact form (Resend). Copy this file to .env.local and fill in a key.
# Without RESEND_API_KEY the form validates but reports that email isn't wired up.

# Required — create one at https://resend.com/api-keys
RESEND_API_KEY=re_UTWbJhx6_C5vesifzTNCr4VmdwjkqJ4Kw

# Optional — where submissions are delivered. Defaults to cmgolizio@gmail.com.
CONTACT_TO=cmgolizio@gmail.com

# Optional — the "From" sender. The default below is Resend's shared onboarding
# address, which only delivers to the Resend account owner — fine for testing.
# For production, verify a domain (https://resend.com/domains) and use it, e.g.
#   CONTACT_FROM="Christopher Golizio <hi@yourdomain.com>"
CONTACT_FROM="Portfolio <onboarding@resend.dev>"